rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and Role helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    function isOwnerOf(centerId) {
      return isAuthenticated() && request.auth.token.role == 'owner' && request.auth.token.centerId == centerId;
    }

    // User collection
    match /users/{userId} {
      allow read: if isSuperadmin() || (isAuthenticated() && request.auth.uid == userId);
      // Allow authenticated user to create or update profile without tampering with role or creation date
      allow create: if isSuperadmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isSuperadmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdAt'])
      );
      allow delete: if isSuperadmin();
    }

    // Centers collection
    match /centers/{centerId} {
      // Public read of active center details
      allow read: if isSuperadmin() || isOwnerOf(centerId) || resource.data.status == 'active';
      // Allow authenticated owner to create and update their center profile
      allow create: if isSuperadmin() || (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isSuperadmin() || (
        isAuthenticated() && 
        (resource.data.ownerUid == request.auth.uid || isOwnerOf(centerId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'id', 'subscriptionId'])
      );
      allow delete: if isSuperadmin();

      // Print Jobs subcollection (Tenant Isolated)
      match /printJobs/{jobId} {
        allow read: if isSuperadmin() || isOwnerOf(centerId);
        // Only allow status updates from authorized owner
        allow update: if isOwnerOf(centerId) && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt']);
        allow create, delete: if isSuperadmin();
      }

      // Analytics subcollection
      match /analytics/{periodId} {
        allow read: if isSuperadmin() || isOwnerOf(centerId);
        allow write: if isSuperadmin();
      }
    }

    // Subscription Plans
    match /plans/{planId} {
      allow read: if true; // Publicly viewable pricing tiers
      allow write: if isSuperadmin();
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isSuperadmin() || (isAuthenticated() && request.auth.token.centerId == resource.data.centerId);
      allow write: if false; // Only manageable via trusted Cloud Functions
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isSuperadmin();
      allow write: if false; // Only server-side logging permitted
    }

    // Webhook idempotency events
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
